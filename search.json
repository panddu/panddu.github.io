---
layout: null
permalink: /search.json
---
[{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y.%m.%d" | jsonify }},
    "category": {% if post.category and site.data.series[post.category] %}{{ site.data.series[post.category].display | jsonify }}{% else %}{{ post.category | jsonify }}{% endif %},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | normalize_whitespace | truncate: 160 | jsonify }}
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
